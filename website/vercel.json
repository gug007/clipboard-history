{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.clipboard-history.cc"
        }
      ],
      "destination": "https://clipboard-history.cc/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*).jsx",
      "destination": "/_internal-source-not-found"
    },
    {
      "source": "/(.*).md",
      "destination": "/_internal-source-not-found"
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/_internal-source-not-found"
    },
    {
      "source": "/.DS_Store",
      "destination": "/_internal-source-not-found"
    },
    {
      "source": "/(.*)/.DS_Store",
      "destination": "/_internal-source-not-found"
    }
  ],
  "headers": [
    {
      "source": "/og-v2.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).jsx",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/.DS_Store",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/(.*)/.DS_Store",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    }
  ]
}
